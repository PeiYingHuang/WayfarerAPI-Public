{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": "",
    "ExpiresMinutes": 60,
    "RefreshTokenExpiresDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "WayfarerAPI"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GcpStorage": {
    "BucketName": "",
    "KeyFilePath": "",
    "SignedUrlExpiresMinutes": 10
  },
  "OpenAI": {
    "ApiKey": "",
    "OcrModel": "",
    "ItineraryModel": ""
  },
  "AllowedHosts": "*"
}
